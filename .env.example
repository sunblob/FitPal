# --- API (apps/api) ---
PORT=3000
DATABASE_URL=postgres://fitpal:fitpal@localhost:5432/fitpal

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# polling — для локальной разработки, webhook — для продакшена, off — API без бота
TELEGRAM_BOT_MODE=polling
# Публичный HTTPS-адрес API (нужен для webhook)
PUBLIC_API_URL=
# Секрет для заголовка X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=
# Публичный HTTPS-адрес Mini App (кнопка в боте)
MINIAPP_URL=

# Ключ Anthropic для распознавания фото (этап 4)
ANTHROPIC_API_KEY=

# --- Mini App (apps/miniapp) ---
VITE_API_URL=http://localhost:3000
