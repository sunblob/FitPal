# --- API (apps/api) ---
PORT=3000
# Порт Postgres из docker-compose; поменяй, если 5432 занят, и обнови DATABASE_URL
POSTGRES_PORT=5432
DATABASE_URL=postgres://fitpal:fitpal@localhost:5432/fitpal

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# polling — для локальной разработки, webhook — для продакшена, off — API без бота
TELEGRAM_BOT_MODE=polling
# Публичный HTTPS-адрес API (нужен для webhook)
PUBLIC_API_URL=
# Секрет для заголовка X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=
# Публичный HTTPS-адрес Mini App (кнопка в боте)
MINIAPP_URL=

# Ключ Anthropic: планы тренировок, перевод упражнений, распознавание фото
# База продуктов и штрихкодов (по умолчанию https://world.openfoodfacts.org)
# OFF_BASE_URL=
# Товары каких стран показывать в поиске первыми (по умолчанию en:slovakia,en:czech-republic)
# OFF_PREFERRED_COUNTRIES=

ANTHROPIC_API_KEY=
# Модель Claude (по умолчанию claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5
# Откуда грузить картинки упражнений (по умолчанию free-exercise-db через jsDelivr)
# EXERCISE_MEDIA_BASE_URL=https://cdn.jsdelivr.net/gh/yuhonas/free-exercise-db@main/exercises/

# Админка: Telegram ID через запятую, кому разрешён вход (пусто — админка выключена)
ADMIN_TELEGRAM_IDS=

# --- Mini App (apps/miniapp) ---
VITE_API_URL=http://localhost:3000

# --- Админка (apps/admin) ---
# Адрес API берётся из VITE_API_URL. Username бота без @ для Telegram Login Widget
VITE_ADMIN_BOT_USERNAME=
